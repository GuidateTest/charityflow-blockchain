# Copy this to .env and fill in your values
# IPFS (Pinata - get free JWT at https://app.pinata.cloud)
VITE_PINATA_JWT=your_pinata_jwt_token

# Sepolia mode (real testnet transactions)
VITE_NETWORK=sepolia
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia Testnet
VITE_RPC_URL=https://rpc.sepolia.org
VITE_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
VITE_CONTRACT_ADDRESS=0xYourSepoliaContractAddress
VITE_DEPLOYMENT_BLOCK=0
VITE_ACTIVITY_LOOKBACK_BLOCKS=50000
